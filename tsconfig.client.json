{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "src/config.ts", "src/settings-remote/types.ts"],
  "exclude": ["lib", "node_modules", "tests"]
}
